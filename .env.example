# PostgreSQL credentials (read only by the local server)
DB_USER=postgres
DB_PASSWORD=replace-with-your-new-local-database-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rodas_system

# Local administrator created the first time the server starts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-6-characters
SESSION_SECRET=replace-with-a-long-random-secret

# Optional IT SMS alerts; the API key stays on the server
AFRICAS_TALKING_USERNAME=your_username
AFRICAS_TALKING_API_KEY=your_api_key
IT_SUPPORT_PHONE=+251900000000